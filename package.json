{
	"name": "fakturian",
	"version": "1.0.0",
	"private": true,
	"description": "Fakturace pro OSVČ neplátce DPH",
	"license": "FSL-1.1-MIT",
	"type": "module",
	"main": ".output/desktop/main.mjs",
	"scripts": {
		"dev": "bun run desktop:build && concurrently --kill-others --success command-electron --names nuxt,electron -P \"bun run dev:web\" \"wait-on http-get://127.0.0.1:1420 && cross-env FAKTURIAN_DEV_URL=http://127.0.0.1:1420 electron . {@}\" --",
		"dev:web": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare && node node_modules/electron/install.js",
		"build": "bun run generate && bun run desktop:build && electron-builder --config electron-builder.yml",
		"start": "electron .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:release-smoke": "node test/smoke/release-smoke.ts",
		"test:e2e:visual": "playwright test test/e2e/visual",
		"test:e2e:visual:update": "playwright test test/e2e/visual --update-snapshots=all",
		"typecheck:e2e": "tsc --noEmit -p test/e2e/tsconfig.json",
		"mutants:ts": "node tools/mutation/mutants-ts.ts",
		"lint": "oxlint --fix --type-aware --ignore-pattern 'test/**' --ignore-pattern 'desktop/test/**' . && oxlint --fix --type-aware test/smoke && oxlint --fix test desktop/test && eslint \"src/**/*.vue\" --fix",
		"lint:check": "oxlint --type-aware --ignore-pattern 'test/**' --ignore-pattern 'desktop/test/**' . && oxlint --type-aware test/smoke && oxlint test desktop/test && eslint \"src/**/*.vue\"",
		"lint:scales": "node tools/lint/check-tailwind-scales.ts",
		"lint:dead-css": "node tools/lint/check-dead-css.ts",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p desktop/tsconfig.json && tsc --noEmit -p showcase/tsconfig.scripts.json",
		"desktop:build": "node tools/desktop/build.ts",
		"check": "bun run lint:check && bun run lint:scales && bun run lint:dead-css && bun run format:check && bun run typecheck && bun run typecheck:e2e && bun run test -- --coverage && bun run generate && bun run desktop:build && bun audit --audit-level=low"
	},
	"dependencies": {
		"@myriaddreamin/typst-ts-node-compiler": "0.8.0-rc3",
		"@napi-rs/keyring": "2.1.2",
		"xmllint-wasm": "5.3.0"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.154",
		"@internationalized/date": "^3.12.4",
		"@nuxt/test-utils": "4.3.2",
		"@nuxt/ui": "4.11.2",
		"@playwright/test": "^1.65.1",
		"@stryker-mutator/api": "^10.1.1",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/big.js": "^7.0.0",
		"@types/node": "^24.19.2",
		"@types/qrcode": "1.5.6",
		"@vitest/coverage-v8": "5.1.0",
		"@vue/test-utils": "^2.5.1",
		"@vueuse/core": "^14.4.0",
		"@vueuse/router": "^14.4.0",
		"@xmldom/xmldom": "0.9.12",
		"big.js": "^7.0.1",
		"concurrently": "^10.0.7",
		"cross-env": "^10.1.0",
		"echarts": "^6.1.0",
		"electron": "44.11.3",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.2",
		"eslint": "^10.15.0",
		"eslint-plugin-vue": "^10.12.1",
		"fast-check": "^4.10.2",
		"fast-png": "8.0.0",
		"happy-dom": "^21.0.4",
		"jsqr": "1.4.0",
		"nuxt": "^4.6.4",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"p-limit": "7.3.3",
		"pdf-lib": "1.17.1",
		"postcss": "^8.5.33",
		"qrcode": "1.5.4",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "5.1.0",
		"wait-on": "^9.5.1",
		"vue": "^3.5.45",
		"vue-echarts": "^8.3.2",
		"vue-eslint-parser": "^10.4.2",
		"vue-tsc": "^3.3.14",
		"zod": "^4.6.7"
	},
	"overrides": {
		"@electron/universal": {
			"minimatch": "11.0.1"
		},
		"@eslint/config-array": {
			"minimatch": "11.0.1"
		},
		"@rollup/plugin-node-resolve": {
			"deepmerge": "4.1.2"
		},
		"@stryker-mutator/core": {
			"minimatch": "11.0.1"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "11.0.1"
		},
		"@vercel/nft": {
			"glob": "14.0.2"
		},
		"app-builder-lib": {
			"minimatch": "11.0.1"
		},
		"diff": "8.0.4",
		"editorconfig": {
			"minimatch": "11.0.1"
		},
		"esbuild": "0.28.2",
		"eslint": {
			"minimatch": "11.0.1"
		},
		"js-beautify": {
			"glob": "14.0.2"
		},
		"qs": "6.16.1",
		"readdir-glob": {
			"minimatch": "11.0.1"
		},
		"serialize-javascript": "7.1.3",
		"vite": "8.3.7"
	},
	"engines": {
		"node": "^24.11.0"
	},
	"packageManager": "bun@1.4.3",
	"productName": "Fakturian",
	"trustedDependencies": [
		"@parcel/watcher",
		"electron",
		"esbuild",
		"vue-demi"
	]
}
